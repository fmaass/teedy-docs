{
  "name": "teedy-docs",
  "description": "Lightweight document management system",
  "license": "GPL-2.0",
  "version": "3.8.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{vue,ts}\" \"e2e/**/*.ts\" --ignore-pattern \"e2e/lint-fixtures/**\"",
    "lint:teardown-rule": "node scripts/check-teardown-lint-rule.mjs",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "fixtures:quill": "node scripts/export-quill-fixtures.mjs",
    "typecheck:e2e": "tsc --noEmit -p e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@tanstack/vue-query": "~5.101.4",
    "axios": "~1.19.0",
    "chart.js": "4.5.1",
    "dompurify": "^3.3.3",
    "pdfjs-dist": "^6.2.108",
    "pinia": "~3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "4.5.5",
    "qrcode-generator": "2.0.4",
    "quill": "2.0.3",
    "vue": "~3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "~6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "vite": "~7.3.5",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "~2.2.12"
  }
}
